# Copia este archivo como .env y rellena tus claves.
# El servidor también acepta las variables directamente en el entorno.
# NUNCA subas el .env al repositorio.

# Base de datos (obligatoria para cuentas, tienda y clasificación).
MONGODB_URI="mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="monopoly_taktak"
PORT=3000

# --- Pagos reales: Stripe (https://dashboard.stripe.com/apikeys) ---
# Sin estas claves la tienda responde con un error claro; nunca finge un pago.
STRIPE_SECRET_KEY="sk_live_o_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Pagos reales: MercadoPago (https://www.mercadopago.com/developers) ---
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MERCADOPAGO_WEBHOOK_SECRET="..."

# --- Zinli: datos de cobro de la plataforma (pago manual) ---
ZINLI_RECEIVER_EMAIL="pagos@tudominio.com"
ZINLI_RECEIVER_PHONE="+584120000000"
ZINLI_RECEIVER_NAME="Monopoly Tak Tak"

# --- IA que valida los comprobantes (elige una) ---
# Sin ninguna configurada, todo comprobante va a revisión manual.
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Administración ---
# Protege la aprobación de KYC, la revisión de comprobantes y los retiros.
ADMIN_TOKEN="pon-un-token-largo-y-aleatorio"

# --- Solo desarrollo. NUNCA en producción ---
# Devuelve los códigos de verificación en la respuesta de la API.
TAKTAK_DEV_CODES=""
# Cuentas y tienda con datos en memoria (se borran al reiniciar).
TAKTAK_MEMORY_DB=""

# ---------- Libro contable (PostgreSQL) ----------
# Sin DATABASE_URL el servidor arranca igual y las rutas de dinero dan 503.
DATABASE_URL="postgres://usuario:clave@host:5432/taktak"
DATABASE_POOL="8"
PROJECT_ID="tak-tak"
COIN_SYMBOL="MTC"

# Token para las rutas de administrador (conciliación, KYC). Largo y aleatorio.
ADMIN_TOKEN=""

# ---------- Airtm (DESHABILITADO a propósito) ----------
# No hay endpoints implementados: faltan el producto contratado y su
# documentación oficial. No pongas credenciales esperando que funcione.
AIRTM_ENVIRONMENT="disabled"
AIRTM_BASE_URL=""
AIRTM_API_KEY=""
AIRTM_API_SECRET=""

# ---------- Cobro del operador (el 10%) ----------
# Identificador público donde TÚ recibes tu parte. No es un secreto: se muestra
# al pagador. Nunca pongas aquí contraseñas ni tokens.
# Ejemplo de forma válida: OPERATOR_PAYOUT_HANDLE="taktak38847eb2"
# No pongas la URL completa (https://airtm.me/...): solo el identificador.
OPERATOR_PAYOUT_HANDLE=""
OPERATOR_PAYOUT_CHANNEL="airtm"

# ---------- Partidas con entrada real (APAGADAS por defecto) ----------
# Con "1" se activan las partidas con entrada de monedas compradas con dinero
# real. Exige además DATABASE_URL. Sin licencia de juego, déjalo apagado.
# Cuando está apagado, el juego funciona igual: se juega sin apostar.
REAL_MONEY_ROUNDS="0"
